{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": true,
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "points": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },
    "bins": {
      ".read": true,
      "$station": {
        ".write": true,
        "zone": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "updated": { ".validate": "newData.isString()" },
        "columns": {
          "$col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
        },
        "$other": { ".validate": false }
      }
    },
    "logs": {
      ".read": true,
      "$logId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['type', 'text', 'time'])",
        "type": { ".validate": "newData.val() === 'scan' || newData.val() === 'reward' || newData.val() === 'alert'" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "time": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": false }
      }
    }
  }
}
